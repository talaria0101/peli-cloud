node_modules/
__pycache__/
*.pyc

# The third-party corpus is fetched, not vendored. ariana-dot-dev/battleships
# publishes no licence: `gh api repos/ariana-dot-dev/battleships` returns
# license: null and there is no LICENSE file in its tree. Redistributing its
# 1183 files inside a 0BSD project grants rights nobody granted, so the corpus
# is a build input restored by experiments/10-fetch-corpus.sh at a pinned
# commit. See NOTICE.
references/battleships/

# The relay SSH check's work dir. It holds a minted dropssh pair - a node token
# and a connect token, both bearer credentials that expire within 72 h - plus
# host and client private keys. The script writes it mode 600 and never prints
# a token, but a credential in a working tree is one `git add .` away from being
# published, so the directory is excluded here rather than trusted. Drop it to
# rotate the pair.
.dropssh-check/

# tools/check-quotes.py caches fetched provider pages here for a week. They are
# third-party HTML, which NOTICE says is not committed, and a cache that goes
# stale silently would let the quote check pass against a page that has since
# changed. Delete it to force a re-fetch.
.quote-cache/
